@startuml
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans CJK TC"
skinparam dpi 150
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280
skinparam ParticipantPadding 10
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceArrowColor #1E293B
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontColor #0F172A
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #D97706

autonumber
participant "核心開機 /\ninit.rc" as KernelBoot
participant "使用者行程\n(ProcessState)" as UserProc
participant "binder.c" as Binder
participant "binderfs.c" as BinderFS
participant "binder_alloc.c" as Alloc
participant "Linux VM\nShrinker" as VM

group #EFF6FF 5.1.2 初始化與 binderfs 掛載
  KernelBoot -> Binder : device_initcall(binder_init)
  Binder -> Alloc : binder_alloc_shrinker_init() (建 binder_freelist + shrinker)
  Binder -> BinderFS : init_binderfs() (register_filesystem "binder")
  KernelBoot -> BinderFS : mount binder /dev/binderfs stats=global
  BinderFS -> BinderFS : binderfs_init_fs_context() -> on_binderfs_mount()
  BinderFS -> BinderFS : binderfs_fill_super() -> 建立 binder-control 與 binder/hwbinder/vndbinder
  KernelBoot -> KernelBoot : symlink /dev/binderfs/* -> /dev/{binder,hwbinder,vndbinder}
end

group #F0FDF4 5.1.3 開啟與 5.1.4 記憶體映射
  UserProc -> Binder : open("/dev/binder", O_RDWR|O_CLOEXEC) -> binder_open()
  Binder -> Binder : 綁定 binder_dev->context、初始化 dbitmap 與雙鎖
  Binder -> Alloc : binder_alloc_init() (mmgrab + 綁定 binder_freelist)
  UserProc -> Binder : ioctl(BINDER_VERSION / BINDER_SET_MAX_THREADS / ONEWAY_SPAM)
  UserProc -> Binder : mmap(BINDER_VM_SIZE, PROT_READ) -> binder_mmap()
  Binder -> Alloc : binder_alloc_mmap_handler() (僅配 pages[] 與初始空閒 buffer，不配實體頁)
end

group #FFF7ED 5.1.5 緩衝區分配、拷貝、釋放與延遲回收
  UserProc -> Binder : BC_TRANSACTION -> binder_transaction()
  Binder -> Alloc : binder_alloc_new_buf()
  Alloc -> Alloc : [鎖內] binder_alloc_new_buf_locked() (best-fit 切分 + binder_lru_freelist_del)
  Alloc -> Alloc : [鎖外] binder_install_buffer_pages() -> alloc_page + vm_insert_page
  Binder -> Alloc : binder_alloc_copy_user_to_buffer() (kmap_local_page 逐頁單次拷貝)
  UserProc -> Binder : BC_FREE_BUFFER -> binder_thread_write()
  Binder -> Alloc : binder_alloc_prepare_to_free() (查 allocated_buffers + 清 allow_user_free)
  Binder -> Alloc : binder_free_buf() -> binder_alloc_free_buf()
  Alloc -> Alloc : clear_on_free(若需要) + binder_lru_freelist_add() + 前後空閒塊合併
  VM --> Alloc : 記憶體壓力觸發 binder_shrink_scan() -> binder_alloc_free_page()
  Alloc --> VM : zap_page_range_single() + ~__free_page()
end
@enduml
