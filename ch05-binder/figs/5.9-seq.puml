@startuml
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans CJK TC"
skinparam dpi 150
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280
skinparam ParticipantPadding 10
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceArrowColor #1E293B
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontColor #0F172A
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #D97706

autonumber
participant "Client\n(GraphicsEnv)" as Client
participant "CppBackendShim" as Shim
participant "BackendUnified\nServiceManager" as USM
participant "BinderCache\nWithInvalidation" as Cache
participant "Binder Driver\n(binder.c)" as Drv
participant "ServiceManager\n(servicemanager)" as SM
participant "init\n(Lazy Service)" as Init

Client -> Shim : checkService("gpu") / waitForService(name)
Shim -> USM : checkService2(name) / getService2(name)
USM -> Cache : returnIfCached(name) -> getItem(name)

alt 快取命中且 isBinderAlive() == true
  Cache --> USM : 回傳快取的 IBinder
  USM --> Shim : ServiceWithMetadata(binder, false)
else 快取未命中
  Cache --> USM : nullptr
  USM -> Drv : BpServiceManager::getService2 / checkService2 (BC_TRANSACTION, handle=0)
  Drv -> SM : BR_TRANSACTION_SEC_CTX (含呼叫端 SID)
  SM -> SM : ServiceManager::tryGetService -> tryGetBinder
  SM -> SM : 查 mNameToService + allowIsolated + Access::canFind (SELinux)

  opt 找不到服務且 startIfNotFound == true (getService2)
    SM -->> Init : tryStartService detached thread: SetProperty("ctl.interface_start", "aidl/" + name)
  end

  opt 找到服務 (out != nullptr)
    SM -> SM : guaranteeClient = true + handleServiceClientCallback(2, name, false)
    SM -> SM : Parcel::flattenBinder -> BINDER_TYPE_HANDLE (H_sm) + Stability
  end

  SM -> Drv : BC_REPLY (ServiceWithMetadata)
  Drv -> Drv : binder_transaction (reply=1) -> binder_translate_handle
  note over Drv : binder_get_node_from_ref(SM, H_sm) 取得 Server binder_node\n跨行程建立或複用 Client binder_ref (H_client)；同行程還原 BINDER_TYPE_BINDER
  Drv -> USM : wake_up_interruptible_sync -> BR_REPLY (含 H_client)
  USM -> USM : Parcel::readNullableStrongBinder -> unflattenBinder -> finishUnflattenBinder
  USM -> USM : ProcessState::getStrongProxyForHandle(H_client) -> BpBinder(H_client)
  USM -> USM : toBinderService(name, service, _out)

  opt !isLazyService && isBinderAlive() && ThreadPool > 0
    USM -> Cache : updateCache -> setItem(name, binder)
    Cache -> Drv : linkToDeath(BinderInvalidation) (BC_REQUEST_DEATH_NOTIFICATION)
    Cache -> Cache : mCache[name] = Entry(binder, deathRecipient)
  end

  USM --> Shim : Status::ok() + ServiceWithMetadata
end

Shim --> Client : sp<IBinder> (BpBinder 或同行程 BBinder)
Client -> Client : interface_cast -> asInterface -> queryLocalInterface / BpGpuService::make
@enduml
