@startuml
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans CJK TC"
skinparam dpi 150
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280
skinparam ParticipantPadding 10
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceArrowColor #1E293B
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontColor #0F172A
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #D97706

autonumber
participant "Client 業務層\n/ BpRefBase" as Client
participant "Client\nProcessState" as C_PS
participant "Client\nBpBinder" as BpB
participant "Client\nIPCThreadState" as C_IPC
participant "Binder 核心驅動\n(ref / node)" as Driver
participant "Server\nIPCThreadState" as S_IPC
participant "Server\nBBinder" as BB

group #EFF6FF 階段一：Server 傳出本地物件，核心建立 node 與 ref 並通知 Server 加計數
  Driver -> Driver : binder_translate_binder() -> binder_new_node() (tmp_refs=1)
  Driver -> Driver : binder_inc_ref_for_node() -> get_ref_desc_olocked (dbitmap) -> binder_inc_ref_olocked()
  Driver -> Driver : binder_inc_node_nilocked() -> 將 node->work 入隊 Server thread->todo
  Driver -> Driver : binder_put_node() -> binder_dec_node_tmpref()
  Driver --> S_IPC : binder_thread_read (BINDER_WORK_NODE) -> binder_put_node_cmd(BR_INCREFS, BR_ACQUIRE)
  S_IPC -> BB : executeCommand(): refs->incWeak(), obj->incStrong()
  S_IPC -> Driver : mOut 寫入 BC_INCREFS_DONE, BC_ACQUIRE_DONE
  Driver -> Driver : binder_thread_write(): 清 pending_*_ref -> binder_dec_node_nilocked(internal=0) -> binder_put_node()
end

group #F0FDF4 階段二：Client 收到 handle 建立 BpBinder / BpRefBase 並增引用
  Client -> C_PS : getStrongProxyForHandle(handle) (鎖 mLock + attemptIncWeak)
  C_PS -> BpB : BpBinder::PrivateAccessor::create(handle, &postTask)
  BpB -> BpB : extendObjectLifetime(OBJECT_LIFETIME_WEAK)
  BpB -> C_IPC : incWeakHandle(handle, this) -> 寫入 BC_INCREFS (+ mPostWriteWeakDerefs 或 flushIfNeeded)
  C_PS --> Client : 返回 sp<BpBinder>，觸發 BpBinder::onFirstRef()
  BpB -> C_IPC : incStrongHandle(handle, this) -> 寫入 BC_ACQUIRE (+ mPostWriteStrongDerefs 或 flushIfNeeded)
  Client -> Client : BpRefBase 建構 incStrong+createWeak -> onFirstRef 設 kRemoteAcquired
  C_IPC -> Driver : talkWithDriver() -> ioctl(BINDER_WRITE_READ)
  Driver -> Driver : binder_thread_write(): binder_update_ref_for_handle -> binder_inc_ref_olocked (s++, w++)
  C_IPC -> C_IPC : processPostWriteDerefs() 釋放臨時引用
end

group #FEF2F2 階段三：Client 釋放代理，核心逐層遞減並通知 Server 釋放 BBinder
  Client -> BpB : BpRefBase::onLastStrongRef() -> mRemote->decStrong()
  BpB -> BpB : BpBinder::onLastStrongRef() (清理 mObituaries / mFrozen)
  BpB -> C_IPC : decStrongHandle(handle) -> 寫入 BC_RELEASE (依 kDecStrongLast 排序)
  Client -> BpB : ~BpRefBase() -> mRefs->decWeak() -> 觸發 ~BpBinder()
  BpB -> C_IPC : expungeHandle(handle, this) -> ProcessState 清空 handle_entry
  BpB -> C_IPC : decWeakHandle(handle) -> 寫入 BC_DECREFS (+ flushIfNeeded)
  C_IPC -> Driver : ioctl(BINDER_WRITE_READ)
  Driver -> Driver : binder_dec_ref_olocked(): strong 1->0 呼叫 binder_dec_node()
  Driver -> Driver : strong==0 && weak==0 -> binder_cleanup_ref_olocked() (清 dbitmap, 移除 node->refs)
  Driver -> Driver : binder_dec_node_nilocked() -> node->work 入隊 Server proc->todo 並喚醒
  Driver -> Driver : 解 outer_lock -> binder_free_ref() + try_shrink_dmap()
  Driver --> S_IPC : binder_thread_read (BINDER_WORK_NODE): 釋放 node 並送出 BR_RELEASE, BR_DECREFS
  S_IPC -> S_IPC : executeCommand(): 壓入 mPendingStrongDerefs, mPendingWeakDerefs
  S_IPC -> BB : processPendingDerefs(): 依序執行 refs->decWeak() 與 obj->decStrong()
end
@enduml
