@startuml
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans CJK TC"
skinparam dpi 150
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280
skinparam ParticipantPadding 10
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceArrowColor #1E293B
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontColor #0F172A
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #D97706

autonumber
participant "init 行程" as Init
participant "servicemanager\n(main.cpp)" as Main
participant "ServiceManager\n/ Access" as SM
participant "ProcessState" as PS
participant "IPCThreadState" as IPC
participant "utils/Looper\n(epoll)" as Looper
participant "Binder 核心驅動\n(binder.c)" as Driver

group #EFF6FF 5.6.1 啟動配置與開啟／映射 Binder 裝置
  Init -> Main : 解析 servicemanager.rc 啟動 /system/bin/servicemanager
  Main -> PS : ProcessState::initWithDriver("/dev/binder")
  PS -> Driver : open("/dev/binder", O_RDWR|O_CLOEXEC) -> binder_open
  PS -> Driver : ioctl(BINDER_VERSION / BINDER_SET_MAX_THREADS=15 / ONEWAY_SPAM)
  PS -> Driver : mmap(BINDER_VM_SIZE) -> binder_mmap -> binder_alloc_mmap_handler
  Main -> PS : setThreadPoolMaxThreadCount(0)
  PS -> Driver : ioctl(BINDER_SET_MAX_THREADS, 0) -> proc->max_threads = 0
  Main -> PS : setCallRestriction(FATAL_IF_NOT_ONEWAY)
  Main -> IPC : IPCThreadState::self()->disableBackgroundScheduling(true)
end

group #F0FDF4 5.6.2 建構 ServiceManager 並註冊為 Context Manager
  Main -> SM : make ServiceManager(make_unique<Access>) + setRequestingSid(true)
  Main -> SM : manager->addService("manager", manager, ...) 自註冊
  Main -> IPC : setTheContextObject(manager) 存入 the_context_object
  Main -> PS : becomeContextManager()
  PS -> Driver : ioctl(BINDER_SET_CONTEXT_MGR_EXT, &obj[TXN_SECURITY_CTX])
  Driver -> Driver : binder_ioctl -> binder_get_thread -> binder_ioctl_set_ctx_mgr
  Driver -> Driver : security_binder_set_context_mgr + UID 檢查
  Driver -> Driver : binder_new_node(proc, &fbo) 設 txn_security_ctx=1
  Driver -> Driver : 設 local/has strong+weak refs 並寫入 context->binder_context_mgr_node
end

group #FFF7ED 5.6.3 進入單執行緒 Looper 事件迴圈
  Main -> Looper : Looper::prepare(false)
  Main -> IPC : BinderCallback::setupTo -> setupPolling(&mBinderFd)
  IPC -> Driver : 寫入 BC_ENTER_LOOPER -> flushCommands -> talkWithDriver(false)
  Driver -> Driver : binder_thread_write -> thread->looper |= BINDER_LOOPER_STATE_ENTERED
  Main -> Looper : looper->addFd(mBinderFd, EVENT_INPUT, BinderCallback)
  Looper -> Driver : epoll_ctl(ADD) -> binder_poll (設 BINDER_LOOPER_STATE_POLL + poll_wait)
  Main -> Looper : ClientCallbackCallback::setupTo (timerfd 5s -> looper->addFd)
  Main -> Init : SetProperty("servicemanager.ready", "true")
  loop 無限事件迴圈
    Main -> Looper : looper->pollAll(-1) 阻塞於 epoll_wait
    Driver --> Looper : 交易到達 -> binder_wakeup_poll_threads_ilocked 喚醒 thread->wait (EPOLLIN)
    Looper -> IPC : BinderCallback::handleEvent -> handlePolledCommands()
    IPC -> Driver : getAndExecuteCommand -> talkWithDriver(true) -> binder_thread_read
    IPC -> SM : executeCommand(BR_TRANSACTION_SEC_CTX, ptr==0) -> the_context_object->transact
    IPC -> Driver : processPendingDerefs() + flushCommands()
    Looper -> SM : 每 5 秒 timerfd 到期 -> handleClientCallbacks() + repoll()
    SM -> Driver : BINDER_GET_NODE_INFO_FOR_REF 查詢 Lazy Service 強引用計數
  end
end
@enduml
