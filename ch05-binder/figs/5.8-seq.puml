@startuml
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans CJK TC"
skinparam dpi 150
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280
skinparam ParticipantPadding 10
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceArrowColor #1E293B
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontColor #0F172A
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #D97706

autonumber
participant "GpuService\n(main)" as GpuMain
participant "CppBackendShim /\nBackendUnifiedSM / BpSM" as Shim
participant "GpuService\nBpBinder / IPCThreadState" as C_IPC
participant "Binder 核心驅動\n(binder.c)" as Driver
participant "servicemanager\nLooper / IPCThreadState" as SM_Loop
participant "ServiceManager\n/ Access" as SM

group #EFF6FF 階段一（5.8.1）：註冊 Service (addService 同步跨行程交易)
  GpuMain -> Shim : defaultServiceManager()->addService("gpu", gpuservice, false)
  Shim -> Shim : CppBackendShim -> BackendUnifiedSM -> AIDL BpServiceManager
  Shim -> Shim : Parcel::writeStrongBinder -> flattenBinder (BINDER_TYPE_BINDER) + Stability
  Shim -> C_IPC : BpBinder(0)::transact -> IPCThreadState::transact
  C_IPC -> C_IPC : writeTransactionData(BC_TRANSACTION) -> waitForResponse -> talkWithDriver
  C_IPC -> Driver : ioctl(BINDER_WRITE_READ) -> binder_thread_write -> binder_transaction
  Driver -> Driver : handle==0 查 context->binder_context_mgr_node + security_binder_transaction
  Driver -> Driver : target_node->txn_security_ctx -> 嵌入呼叫端 SELinux secctx
  Driver -> Driver : binder_translate_binder: 建 binder_node + 建 servicemanager binder_ref (HANDLE)
  Driver -> Driver : binder_enqueue_deferred_thread_work_ilocked(tcomplete) 延遲回報
  Driver -> SM_Loop : binder_proc_transaction -> proc->todo + binder_wakeup_poll_threads_ilocked
  note over C_IPC, Driver : GpuService 主執行緒於 binder_thread_read 睡眠等待 BR_REPLY
  SM_Loop -> Driver : Looper::pollAll 醒來 -> handlePolledCommands -> talkWithDriver -> binder_thread_read
  Driver --> SM_Loop : 下發 BR_TRANSACTION_SEC_CTX (含 secctx 與 target.ptr==0)
  SM_Loop -> SM : executeCommand -> the_context_object -> BBinder::transact -> BnServiceManager::onTransact
  SM -> SM : Parcel::unflattenBinder -> getStrongProxyForHandle(desc) 建 BpBinder
  SM -> SM : ServiceManager::addService -> Access::canAdd (selinux_check_access)
  SM -> SM : binder->linkToDeath(this) + 寫入 mNameToService["gpu"] + 通知 IServiceCallback
  SM --> SM_Loop : 返回 Status::ok() 寫入 reply Parcel
  SM_Loop -> SM_Loop : buffer.setDataSize(0) 寫入 BC_FREE_BUFFER -> sendReply 寫入 BC_REPLY
  SM_Loop -> Driver : ioctl(BINDER_WRITE_READ) -> 釋放請求緩衝區 + binder_transaction(reply=1)
  Driver --> SM_Loop : BR_TRANSACTION_COMPLETE (回到 Looper::pollAll)
  Driver --> C_IPC : 喚醒 GpuService -> binder_thread_read 送回 BR_TRANSACTION_COMPLETE + BR_REPLY
  C_IPC --> Shim : waitForResponse 綁定 reply Parcel 並返回 NO_ERROR
  Shim -> Shim : BackendUnifiedSM::updateCache + 析構 reply (BC_FREE_BUFFER)
  Shim --> GpuMain : 返回 OK
end

group #F0FDF4 階段二（5.8.2）：啟動 Binder 執行緒池與動態擴容
  GpuMain -> Driver : setThreadPoolMaxThreadCount(4) -> ioctl(BINDER_SET_MAX_THREADS)
  GpuMain -> GpuMain : startThreadPool() -> spawnPooledThread(true) 建立 PoolThread(true)
  GpuMain -> C_IPC : PoolThread(true) 與主執行緒各自呼叫 joinThreadPool(true)
  C_IPC -> Driver : 寫入 BC_ENTER_LOOPER -> 標記 ENTERED 並掛入 proc->waiting_threads 休眠
  note over C_IPC, Driver : 高併發下 waiting_threads 清空且 requested_threads_started 小於 max_threads
  Driver --> C_IPC : binder_thread_read 覆寫首部 BR_NOOP 為 BR_SPAWN_LOOPER (requested_threads++)
  C_IPC -> C_IPC : executeCommand(BR_SPAWN_LOOPER) -> spawnPooledThread(false)
  C_IPC -> Driver : 新 PoolThread(false) -> joinThreadPool(false) -> BC_REGISTER_LOOPER (requested_threads~--, started++)
end
@enduml
