@startuml
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans CJK TC"
skinparam dpi 150
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam ArrowColor #1E293B

interface LogBuffer {
  {abstract} +Init() : void
  {abstract} +Log(log_id, realtime, uid, pid, tid, msg, len) : int
  {abstract} +CreateFlushToState(start, log_mask) : unique_ptr<FlushToState>
  {abstract} +FlushTo(writer, state, filter) : bool
  {abstract} +Clear(id, uid) : bool
  {abstract} +GetSize(id) : size_t
  {abstract} +SetSize(id, size) : bool
  {abstract} +sequence() : uint64_t
}

class SerializedLogBuffer {
  -reader_list_ : LogReaderList*
  -tags_ : LogTags*
  -stats_ : LogStatistics*
  -max_size_ : size_t[LOG_ID_MAX]
  -logs_ : list<SerializedLogChunk>[LOG_ID_MAX]
  -sequence_ : atomic<uint64_t>
  -MaybePrune(log_id) : void
  -Prune(log_id, bytes_to_free) : void
}

class SerializedLogChunk {
  -contents_ : SerializedData
  -write_offset_ : int
  -reader_ref_count_ : uint32_t
  -writer_active_ : bool
  -highest_sequence_number_ : uint64_t
  -compressed_log_ : SerializedData
  -readers_ : vector<SerializedFlushToState*>
  +FinishWriting() : void
  +IncReaderRefCount() : void
  +DecReaderRefCount() : void
  +Log(...) : SerializedLogEntry*
}

class SerializedLogEntry {
  -uid_ : uint32_t
  -pid_ : uint32_t
  -tid_ : uint32_t
  -sequence_ : uint64_t
  -realtime_ : log_time
  -msg_len_ : uint16_t
  +Flush(writer, log_id) : bool
}

interface CompressionEngine {
  {static} +GetInstance() : CompressionEngine
  {abstract} +Compress(in, data_length, out) : bool
  {abstract} +Decompress(in, out) : bool
}

class ZstdCompressionEngine {
  +Compress(in, data_length, out) : bool
  +Decompress(in, out) : bool
}

class FlushToState {
  -start_ : uint64_t
  -log_mask_ : LogMask
}

class SerializedFlushToState {
  -logs_ : list<SerializedLogChunk>*
  -log_positions_ : optional<LogPosition>[LOG_ID_MAX]
  -logs_needed_from_next_position_ : bitset<LOG_ID_MAX>
  +HasUnreadLogs() : bool
  +PopNextUnreadLog() : LogWithId
  +Prune(log_id) : void
}

class LogReaderList {
  -running_reader_threads_ : list<unique_ptr<LogReaderThread>>
  -pending_reader_threads_ : vector<unique_ptr<LogReaderThread>>
  +NotifyNewLog(log_mask) : void
  +AddAndRunThread(thread) : void
  +AddPendingThread(thread) : void
  +HandlePendingThread(...) : bool
}

class LogReaderThread {
  -thread_triggered_condition_ : condition_variable
  -log_buffer_ : LogBuffer*
  -writer_ : unique_ptr<LogWriter>
  -flush_to_state_ : unique_ptr<FlushToState>
  -tail_ : unsigned long
  -non_block_ : bool
  +Run() : void
  +TriggerReader() : void
}

class PruneList {
  -high_priority_prune_ : list<Prune>
  -low_priority_prune_ : list<Prune>
  -worst_uid_enabled_ : bool
  -worst_pid_of_system_enabled_ : bool
  +Init(str) : bool
  +Format() : string
}

LogBuffer <|.. SerializedLogBuffer
SerializedLogBuffer *-- SerializedLogChunk : logs_[LOG_ID_MAX]
SerializedLogChunk o-- SerializedLogEntry : packed in contents_
SerializedLogChunk ..> CompressionEngine : Compress / Decompress
CompressionEngine <|.. ZstdCompressionEngine
FlushToState <|-- SerializedFlushToState
SerializedFlushToState --> SerializedLogChunk : AttachReader / DetachReader
LogReaderList *-- LogReaderThread
LogReaderThread *-- FlushToState
SerializedLogBuffer --> LogReaderList : NotifyNewLog
@enduml
